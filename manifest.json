{
  "manifest_version": 3,
  "name": "Triple J Extension",
  "version": "1.0",
  "description": "Makes the triple j player show the current song.",
  "content_scripts": [
    {
      "matches": ["https://www.abc.net.au/triplej/programs/*"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "triple-j-logo-16.png",
    "48": "triple-j-logo-48.png",
    "32": "triple-j-logo-32.png",
    "128": "triple-j-logo-128.png"
  }
}